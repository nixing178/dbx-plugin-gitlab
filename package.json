{
  "name": "dbx-plugin-gitlab",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-version.mjs && vue-tsc --noEmit && vite build",
    "build:watch": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.0.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
